---
import { Image } from 'astro:assets';
import type { Work } from '../data/works';

interface Props {
	work: Work;
}

const { work } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a class="card" href={base + 'works/' + work.id + '/'}>
	<div class="frame">
		<Image src={work.image} alt={work.title} widths={[600, 900]} sizes="(max-width: 640px) 100vw, 33vw" loading="lazy" />
	</div>
	<div class="meta">
		<h3>{work.title}</h3>
		<p>
			<span class="cat">{work.category}</span>
			<span class="year">{work.year}</span>
		</p>
	</div>
</a>

<style>
	.card {
		display: block;
	}

	.frame {
		overflow: hidden;
		background: var(--paper);
		border: 1px solid var(--line);
		aspect-ratio: 4 / 3;
	}

	.frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.card:hover .frame :global(img) {
		transform: scale(1.04);
	}

	.meta {
		padding: 12px 2px 0;
	}

	.meta h3 {
		font-size: 15px;
		font-weight: 500;
		font-family: 'Noto Sans TC', system-ui, sans-serif;
		letter-spacing: 0.05em;
	}

	.meta p {
		display: flex;
		gap: 12px;
		margin-top: 4px;
		font-size: 12px;
		color: var(--gray);
		letter-spacing: 0.15em;
	}
</style>
