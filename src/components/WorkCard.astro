---
import { Image } from 'astro:assets';
import type { Work } from '../data/works';

interface Props {
	work: Work;
	index: number;
}

const { work, index } = Astro.props;
const base = import.meta.env.BASE_URL;
const idx = String(index).padStart(2, '0');
---

<a class="card" href={base + 'works/' + work.id + '/'}>
	<span class="idx">{idx}</span>
	<div class="frame">
		<Image
			src={work.cover}
			alt={work.title}
			widths={[600, 900]}
			sizes="(max-width: 900px) 100vw, 50vw"
			loading="lazy"
		/>
	</div>
	<div class="meta">
		<h3>{work.title}</h3>
		<p>
			<span class="cat">{work.category}</span>
			<span class="year">{work.year}</span>
		</p>
	</div>
</a>

<style>
	.card {
		position: relative;
		display: block;
		animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.idx {
		position: absolute;
		top: 14px;
		left: 14px;
		z-index: 2;
		font-family: 'Space Grotesk', monospace;
		font-size: 12px;
		letter-spacing: 0.25em;
		color: var(--ink);
		background: rgba(6, 6, 8, 0.55);
		border: 1px solid var(--line);
		backdrop-filter: blur(6px);
		padding: 4px 9px;
		transition: color 0.3s, border-color 0.3s;
	}

	.frame {
		padding: 1px;
		background: linear-gradient(180deg, #2c2c36, #16161d);
		transition: background 0.4s ease, box-shadow 0.4s ease;
	}

	.frame :global(img) {
		width: 100%;
		height: auto;
		display: block;
		filter: saturate(0.9) contrast(1.05);
		transition: transform 0.5s ease, filter 0.4s ease;
	}

	.meta {
		padding: 14px 2px 0;
	}

	.meta h3 {
		font-size: 17px;
		font-weight: 700;
		letter-spacing: 0.05em;
		transition: color 0.3s;
	}

	.meta p {
		display: flex;
		gap: 14px;
		margin-top: 6px;
		font-family: 'Space Grotesk', monospace;
		font-size: 12px;
		letter-spacing: 0.22em;
		color: var(--gray);
	}

	.meta .cat::before {
		content: '◆ ';
		color: var(--prism-cyan);
		font-size: 9px;
		vertical-align: 1px;
	}

	.card:hover .frame {
		background: linear-gradient(
			120deg,
			rgba(109, 179, 255, 0.85),
			rgba(177, 140, 255, 0.7),
			rgba(255, 176, 102, 0.8)
		);
		box-shadow: 0 0 34px rgba(177, 140, 255, 0.22);
	}

	.card:hover .frame :global(img) {
		transform: scale(1.045);
		filter: saturate(1.05) contrast(1.08);
	}

	.card:hover .idx {
		color: var(--prism-amber);
		border-color: rgba(255, 176, 102, 0.5);
	}

	.card:hover .meta h3 {
		color: var(--prism-cyan);
	}
</style>
