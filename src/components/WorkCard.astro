---
import { Image } from 'astro:assets';
import type { Work } from '../data/works';

interface Props {
	work: Work;
	index: number;
}

const { work, index } = Astro.props;
const base = import.meta.env.BASE_URL;
const idx = String(index).padStart(2, '0');
---

<a class="card" href={base + 'works/' + work.id + '/'}>
	<span class="idx">{idx}</span>
	<div class="frame">
		<Image
			src={work.cover}
			alt={work.title}
			widths={[600, 900]}
			sizes="(max-width: 900px) 100vw, 50vw"
			loading="lazy"
		/>
	</div>
	<div class="meta">
		<h3>{work.title}</h3>
		<p>
			<span class="cat">{work.category}</span>
			<span class="year">{work.year}</span>
		</p>
	</div>
</a>

<style>
	.card {
		position: relative;
		display: block;
		transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.card:hover {
		transform: translateY(-10px);
	}

	.idx {
		position: absolute;
		top: 14px;
		left: 14px;
		z-index: 2;
		font-family: 'Space Grotesk', monospace;
		font-size: 12px;
		letter-spacing: 0.25em;
		color: var(--ink);
		background: rgba(6, 6, 8, 0.55);
		border: 1px solid var(--line);
		backdrop-filter: blur(6px);
		padding: 4px 9px;
		transition: border-color 0.3s;
	}

	.frame {
		border: 1px solid var(--line);
		background: var(--surface);
		overflow: hidden;
		transition: border-color 0.35s ease, box-shadow 0.35s ease;
	}

	.frame :global(img) {
		width: 100%;
		height: auto;
		display: block;
		transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.4s ease;
		opacity: 0.92;
	}

	.meta {
		padding: 14px 2px 0;
	}

	.meta h3 {
		font-size: 17px;
		font-weight: 700;
		letter-spacing: 0.05em;
		transition: color 0.3s;
	}

	.meta p {
		display: flex;
		gap: 14px;
		margin-top: 6px;
		font-family: 'Space Grotesk', monospace;
		font-size: 12px;
		letter-spacing: 0.22em;
		color: var(--gray);
	}

	.meta .cat::before {
		content: '◆ ';
		color: var(--prism-cyan);
		font-size: 9px;
		vertical-align: 1px;
	}

	.card:hover .frame {
		border-color: rgba(241, 239, 233, 0.4);
		box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55);
	}

	.card:hover .frame :global(img) {
		transform: scale(1.12) rotate(-1.2deg);
		opacity: 1;
	}

	.card:hover .idx {
		border-color: rgba(241, 239, 233, 0.5);
		background: var(--ink);
		color: #0a0a0c;
	}

	.card:hover .meta h3 {
		color: var(--prism-cyan);
	}
</style>
