---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<p class="credit">
		<span class="sig">ZN</span>
		© {year} 胡正男
	</p>
	<p class="back">
		<a href={base}>回到首頁 ↑</a>
	</p>
</footer>

<style>
	.site-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 36px 24px;
		border-top: 1px solid var(--line);
		font-size: 13px;
		letter-spacing: 0.15em;
		color: var(--gray);
	}

	.credit {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.sig {
		font-family: 'Space Grotesk', monospace;
		font-weight: 700;
		font-size: 15px;
		letter-spacing: 0.2em;
		color: var(--ink);
	}

	.back a {
		transition: color 0.25s;
	}

	.back a:hover {
		color: var(--ink);
	}

	@media (max-width: 640px) {
		.site-footer {
			flex-direction: column;
			gap: 10px;
			text-align: center;
		}
	}
</style>
