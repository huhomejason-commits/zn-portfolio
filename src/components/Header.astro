---
import logo from '../assets/logo/zn.png';

const base = import.meta.env.BASE_URL;
---

<header class="site-header">
	<a class="brand" href={base} aria-label="胡正男作品集首頁">
		<span class="mark"><img src={logo.src} alt="ZN 標誌" width="30" height="22" /></span>
		<span class="name chrome">胡正男</span>
	</a>
	<nav class="nav" aria-label="主要導覽">
		<a href={base + '#works'}>作品</a>
		<a href={base + '#about'}>關於</a>
		<a href={base + '#contact'}>聯絡</a>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 24px;
		background: rgba(6, 6, 8, 0.82);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 18px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.mark {
		display: inline-flex;
		align-items: center;
		padding: 4px 6px;
		background: var(--surface-2);
		border: 1px solid var(--line);
		box-shadow: 0 0 18px rgba(177, 140, 255, 0.12) inset;
	}

	.mark img {
		width: 30px;
		height: 22px;
	}

	.name.chrome {
		font-weight: 900;
		letter-spacing: 0.14em;
	}

	.nav {
		display: flex;
		gap: 30px;
		font-size: 14px;
		letter-spacing: 0.18em;
	}

	.nav a {
		position: relative;
		color: var(--gray);
		transition: color 0.25s;
		padding-bottom: 4px;
	}

	.nav a::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 1px;
		background: linear-gradient(90deg, var(--prism-blue), var(--prism-purple), var(--prism-amber));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.3s ease;
	}

	.nav a:hover {
		color: var(--ink);
	}

	.nav a:hover::after {
		transform: scaleX(1);
	}

	@media (max-width: 640px) {
		.nav {
			gap: 18px;
			font-size: 13px;
		}
	}
</style>
