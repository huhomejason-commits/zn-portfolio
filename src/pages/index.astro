---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import logo from '../assets/logo/zn.png';
import { works } from '../data/works';
---

<BaseLayout title="胡正男 ｜ 設計作品集">
	<!-- Hero -->
	<section class="hero" id="top">
		<img class="hero-logo" src={logo.src} alt="ZN 標誌" width="96" height="96" />
		<h1>胡正男</h1>
		<p class="tagline">繪本創作 ・ 產品設計 ・ 展示設計</p>
		<p class="sub">2022–2026 設計作品集</p>
		<a class="scroll" href="#works">觀看作品 ↓</a>
	</section>

	<!-- Works -->
	<section class="section" id="works">
		<div class="section-head">
			<h2>作品</h2>
			<span>WORKS</span>
		</div>
		<ul class="grid">
			{works.map((work) => (
				<li class="cell">
					<WorkCard work={work} />
				</li>
			))}
		</ul>
	</section>

	<!-- About -->
	<section class="section" id="about">
		<div class="section-head">
			<h2>關於</h2>
			<span>ABOUT</span>
		</div>
		<div class="about-body">
			<p>
				嗨，我是 胡正男。輔仁大學應用美術研究所，擅長從研究、概念發展到設計執行，將設計思維轉化為兼具美感與功能性的作品。相信好的設計不只是解決問題，更能建立人與物之間的情感連結。
			</p>
		</div>
	</section>

	<!-- Contact -->
	<section class="section" id="contact">
		<div class="section-head">
			<h2>聯絡</h2>
			<span>CONTACT</span>
		</div>
		<div class="contact-body">
			<p>有任何合作或交流，歡迎來信。</p>
			<a class="mail" href="mailto:huhomejason@gmail.com">huhomejason@gmail.com</a>
			<ul class="links">
				<li><a href="https://www.behance.net/fa7fd025" target="_blank" rel="noopener">Behance</a></li>
				<li><a href="#" class="placeholder">Instagram</a></li>
				<li><a href="#" class="placeholder">LinkedIn</a></li>
			</ul>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		min-height: 72vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 48px 24px;
	}

	.hero-logo {
		border: 1px solid var(--line);
		margin-bottom: 28px;
	}

	.hero h1 {
		font-size: clamp(44px, 9vw, 96px);
		font-weight: 900;
		letter-spacing: 0.18em;
		margin-right: -0.18em;
	}

	.tagline {
		margin-top: 20px;
		font-size: 16px;
		letter-spacing: 0.2em;
		color: var(--ink);
	}

	.sub {
		margin-top: 8px;
		font-size: 13px;
		letter-spacing: 0.2em;
		color: var(--gray);
	}

	.scroll {
		margin-top: 48px;
		font-size: 13px;
		letter-spacing: 0.25em;
		color: var(--gray);
		transition: color 0.2s;
	}

	.scroll:hover {
		color: var(--ink);
	}

	.grid {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 48px 24px;
	}

	.about-body p {
		max-width: 720px;
		font-size: 17px;
		letter-spacing: 0.05em;
	}

	.contact-body p {
		color: var(--gray);
	}

	.mail {
		display: inline-block;
		margin-top: 16px;
		font-size: 20px;
		font-weight: 500;
		border-bottom: 1px solid var(--ink);
		padding-bottom: 2px;
	}

	.links {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		margin-top: 24px;
		font-size: 14px;
		letter-spacing: 0.15em;
	}

	.links a {
		color: var(--gray);
		transition: color 0.2s;
	}

	.links a:hover {
		color: var(--ink);
	}

	.links .placeholder {
		opacity: 0.5;
	}

	@media (max-width: 640px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
