---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import logo from '../assets/logo/zn.png';
import { works } from '../data/works';
---

<BaseLayout title="胡正男 ｜ 設計作品集">
	<!-- Hero -->
	<section class="hero" id="top">
		<div class="hero-inner">
			<img class="hero-logo" src={logo.src} alt="ZN 標誌" width="96" />
			<p class="kicker">DESIGN PORTFOLIO · 2022–2026</p>
			<h1 class="chrome shine">胡正男</h1>
			<p class="tagline">繪本創作 ・ 產品設計 ・ 展示設計</p>
			<p class="sub">
				以設計思考、視覺敘事與跨領域整合，探索設計在品牌、文化與使用者體驗中的可能性。
			</p>
			<a class="scroll" href="#works">觀看作品 <span>↓</span></a>
		</div>
	</section>

	<!-- Works -->
	<section class="section" id="works">
		<div class="section-head">
			<span class="index">01</span>
			<h2>作品</h2>
			<span class="label">Works</span>
			<i class="rule"></i>
		</div>
		<ul class="grid">
			{works.map((work, i) => (
				<li class="cell" style={`animation-delay: ${i * 120}ms`}>
					<WorkCard work={work} index={i + 1} />
				</li>
			))}
		</ul>
	</section>

	<!-- About -->
	<section class="section" id="about">
		<div class="section-head">
			<span class="index">02</span>
			<h2>關於</h2>
			<span class="label">About</span>
			<i class="rule"></i>
		</div>
		<div class="about-body">
			<h3 class="lead">
				嗨，我是 胡正男。<span class="outline">設計研究生</span>
			</h3>
			<p>
				輔仁大學應用美術研究所，擅長從研究、概念發展到設計執行，將設計思維轉化為兼具美感與功能性的作品。相信好的設計不只是解決問題，更能建立人與物之間的情感連結。
			</p>
		</div>
	</section>

	<!-- Contact -->
	<section class="section" id="contact">
		<div class="section-head">
			<span class="index">03</span>
			<h2>聯絡</h2>
			<span class="label">Contact</span>
			<i class="rule"></i>
		</div>
		<div class="contact-body">
			<p>有任何合作或交流，歡迎來信。</p>
			<a class="mail chrome" href="mailto:huhomejason@gmail.com">huhomejason@gmail.com</a>
			<ul class="links">
				<li><a href="https://www.behance.net/fa7fd025" target="_blank" rel="noopener">Behance ↗</a></li>
				<li><a href="#" class="placeholder">Instagram</a></li>
				<li><a href="#" class="placeholder">LinkedIn</a></li>
			</ul>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		min-height: 92vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 72px 24px;
		position: relative;
		overflow: hidden;
	}

	.hero::before,
	.hero::after {
		content: '';
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
		filter: blur(70px);
		z-index: -1;
	}

	.hero::before {
		width: 520px;
		height: 520px;
		top: -140px;
		left: -120px;
		background: radial-gradient(circle, rgba(109, 179, 255, 0.16), transparent 65%);
	}

	.hero::after {
		width: 560px;
		height: 560px;
		bottom: -180px;
		right: -140px;
		background: radial-gradient(circle, rgba(177, 140, 255, 0.14), transparent 65%);
	}

	.hero-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.hero-logo {
		width: 96px;
		height: auto;
		padding: 6px;
		background: var(--surface-2);
		border: 1px solid var(--line);
		box-shadow: 0 0 30px rgba(177, 140, 255, 0.14), 0 0 60px rgba(109, 179, 255, 0.08);
		margin-bottom: 40px;
	}

	.kicker {
		font-family: 'Space Grotesk', monospace;
		font-size: 12px;
		letter-spacing: 0.4em;
		color: var(--dim);
		margin-bottom: 22px;
	}

	.hero h1 {
		font-size: clamp(64px, 15vw, 200px);
		font-weight: 900;
		letter-spacing: 0.14em;
		margin-right: -0.14em;
		line-height: 1.05;
	}

	.tagline {
		margin-top: 26px;
		font-size: 16px;
		letter-spacing: 0.3em;
		margin-right: -0.3em;
		color: var(--gray);
	}

	.sub {
		margin-top: 16px;
		font-size: 13px;
		letter-spacing: 0.12em;
		color: var(--dim);
		max-width: 560px;
	}

	.scroll {
		margin-top: 56px;
		padding: 12px 34px;
		border: 1px solid var(--line);
		font-size: 13px;
		letter-spacing: 0.3em;
		color: var(--gray);
		transition: all 0.3s;
	}

	.scroll span {
		display: inline-block;
		transition: transform 0.3s;
	}

	.scroll:hover {
		border-color: transparent;
		background: linear-gradient(120deg, var(--prism-blue), var(--prism-purple), var(--prism-amber));
		color: #0a0a0c;
		font-weight: 700;
	}

	.scroll:hover span {
		transform: translateY(3px);
	}

	.hero-inner > * {
		animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	.hero-inner > *:nth-child(1) {
		animation-delay: 0.05s;
	}
	.hero-inner > *:nth-child(2) {
		animation-delay: 0.15s;
	}
	.hero-inner > *:nth-child(3) {
		animation-delay: 0.25s;
	}
	.hero-inner > *:nth-child(4) {
		animation-delay: 0.35s;
	}
	.hero-inner > *:nth-child(5) {
		animation-delay: 0.45s;
	}
	.hero-inner > *:nth-child(6) {
		animation-delay: 0.55s;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(22px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.grid {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 56px 28px;
	}

	.about-body .lead {
		font-size: clamp(24px, 3.4vw, 40px);
		font-weight: 900;
		letter-spacing: 0.04em;
		margin-bottom: 22px;
	}

	.about-body .lead .outline {
		font-weight: 900;
	}

	.about-body p {
		max-width: 680px;
		font-size: 16px;
		letter-spacing: 0.05em;
		color: var(--gray);
	}

	.contact-body p {
		color: var(--gray);
	}

	.mail {
		display: inline-block;
		margin-top: 18px;
		font-size: clamp(22px, 3vw, 34px);
		font-weight: 700;
		letter-spacing: 0.04em;
		padding-bottom: 4px;
		border-bottom: 1px solid var(--line);
		transition: filter 0.3s;
	}

	.mail:hover {
		filter: brightness(1.15);
	}

	.links {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
		margin-top: 30px;
		font-size: 14px;
		letter-spacing: 0.18em;
	}

	.links a {
		display: inline-block;
		padding: 9px 22px;
		border: 1px solid var(--line);
		color: var(--gray);
		transition: all 0.3s;
	}

	.links a:hover {
		border-color: var(--prism-purple);
		color: var(--ink);
		box-shadow: 0 0 22px rgba(177, 140, 255, 0.2);
	}

	.links .placeholder {
		opacity: 0.45;
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
			gap: 44px;
		}
	}

	@media (max-width: 640px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
