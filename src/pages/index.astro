---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import logo from '../assets/logo/zn.png';
import top from '../assets/visual/top.jpg';
import photo from '../assets/visual/photo.jpg';
import bottom from '../assets/visual/bottom.jpg';
import { works } from '../data/works';
---

<BaseLayout title="胡正男 ｜ 設計作品集">
	<!-- Hero：頂層視覺 + 個人照片 -->
	<section class="hero" id="top">
		<div class="hero-bg" style={`background-image: url(${top.src})`} aria-hidden="true"></div>
		<div class="hero-scrim" aria-hidden="true"></div>
		<div class="hero-inner">
			<figure class="photo">
				<img src={photo.src} alt="胡正男 個人照片" />
				<figcaption>胡正男 — 設計研究生</figcaption>
			</figure>
			<div class="copy">
				<p class="kicker">DESIGN PORTFOLIO · 2022–2026</p>
				<h1>胡正男</h1>
				<p class="tagline">繪本創作 ・ 產品設計 ・ 展示設計</p>
				<p class="sub">以設計思考、視覺敘事與跨領域整合，探索設計在品牌、文化與使用者體驗中的可能性。</p>
				<a class="scroll" href="#works">觀看作品 <span>↓</span></a>
			</div>
		</div>
	</section>

	<!-- Works -->
	<section class="section" id="works">
		<div class="section-head">
			<span class="index">01</span>
			<h2>作品</h2>
			<span class="label">Works</span>
			<i class="rule"></i>
		</div>
		<ul class="grid">
			{works.map((work, i) => (
				<li class="cell" style={`animation-delay: ${i * 120}ms`}>
					<WorkCard work={work} index={i + 1} />
				</li>
			))}
		</ul>
	</section>

	<!-- About -->
	<section class="section" id="about">
		<div class="section-head">
			<span class="index">02</span>
			<h2>關於</h2>
			<span class="label">About</span>
			<i class="rule"></i>
		</div>
		<div class="about-body">
			<h3 class="lead">嗨，我是 胡正男。<span class="outline">設計研究生</span></h3>
			<p>
				輔仁大學應用美術研究所，擅長從研究、概念發展到設計執行，將設計思維轉化為兼具美感與功能性的作品。相信好的設計不只是解決問題，更能建立人與物之間的情感連結。
			</p>
		</div>
	</section>

	<!-- Contact -->
	<section class="section" id="contact">
		<div class="section-head">
			<span class="index">03</span>
			<h2>聯絡</h2>
			<span class="label">Contact</span>
			<i class="rule"></i>
		</div>
		<div class="contact-body">
			<p>有任何合作或交流，歡迎來信。</p>
			<a class="mail" href="mailto:huhomejason@gmail.com">huhomejason@gmail.com</a>
			<ul class="links">
				<li><a href="https://www.behance.net/fa7fd025" target="_blank" rel="noopener">Behance ↗</a></li>
				<li><a href="#" class="placeholder">Instagram</a></li>
				<li><a href="#" class="placeholder">LinkedIn</a></li>
			</ul>
		</div>
	</section>

	<!-- 尾層視覺 -->
	<section class="closing" aria-label="感謝觀看">
		<div class="closing-bg" style={`background-image: url(${bottom.src})`} aria-hidden="true"></div>
		<div class="closing-scrim" aria-hidden="true"></div>
		<div class="closing-inner">
			<p class="kicker">THANK YOU FOR WATCHING</p>
			<h2>期待與你相遇</h2>
			<a class="mail" href="mailto:huhomejason@gmail.com">huhomejason@gmail.com</a>
			<a class="top" href="#top">回到頂端 ↑</a>
		</div>
	</section>
</BaseLayout>

<style>
	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		background-position: center;
		background-size: cover;
		transform: scale(1.06);
		animation: settle 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	@keyframes settle {
		from {
			transform: scale(1.14);
			opacity: 0.6;
		}
		to {
			transform: scale(1.06);
			opacity: 1;
		}
	}

	.hero-scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(6, 6, 8, 0.82) 0%, rgba(6, 6, 8, 0.5) 45%, rgba(6, 6, 8, 0.18) 72%, rgba(6, 6, 8, 0.5) 100%),
			linear-gradient(0deg, rgba(6, 6, 8, 0.72) 0%, transparent 32%);
	}

	.hero-inner {
		position: relative;
		width: 100%;
		max-width: 1120px;
		margin: 0 auto;
		padding: 120px 24px 96px;
		display: grid;
		grid-template-columns: 340px 1fr;
		align-items: center;
		gap: 64px;
	}

	.photo {
		background: rgba(10, 10, 12, 0.55);
		border: 1px solid rgba(241, 239, 233, 0.22);
		padding: 10px;
		box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55);
		backdrop-filter: blur(4px);
	}

	.photo img {
		width: 100%;
		height: auto;
	}

	.photo figcaption {
		padding: 12px 4px 4px;
		font-size: 12px;
		letter-spacing: 0.2em;
		color: var(--gray);
		text-align: center;
	}

	.copy .kicker {
		font-family: 'Space Grotesk', monospace;
		font-size: 12px;
		letter-spacing: 0.4em;
		color: var(--gray);
		margin-bottom: 20px;
	}

	.copy h1 {
		font-size: clamp(56px, 9vw, 120px);
		font-weight: 900;
		letter-spacing: 0.12em;
		margin-right: -0.12em;
		line-height: 1.05;
	}

	.copy .tagline {
		margin-top: 22px;
		font-size: 16px;
		letter-spacing: 0.28em;
		margin-right: -0.28em;
		color: var(--gray);
	}

	.copy .sub {
		margin-top: 14px;
		font-size: 13px;
		letter-spacing: 0.12em;
		color: var(--dim);
		max-width: 460px;
	}

	.scroll {
		display: inline-block;
		margin-top: 40px;
		padding: 12px 32px;
		border: 1px solid rgba(241, 239, 233, 0.35);
		font-size: 13px;
		letter-spacing: 0.3em;
		color: var(--ink);
		transition: all 0.3s;
	}

	.scroll span {
		display: inline-block;
		transition: transform 0.3s;
	}

	.scroll:hover {
		background: var(--ink);
		color: #0a0a0c;
		border-color: var(--ink);
		font-weight: 700;
	}

	.scroll:hover span {
		transform: translateY(3px);
	}

	.hero-inner > * {
		animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	.hero-inner > *:nth-child(1) {
		animation-delay: 0.2s;
	}
	.hero-inner > *:nth-child(2) {
		animation-delay: 0.32s;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	/* ---------- Works ---------- */
	.grid {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 56px 28px;
	}

	/* ---------- About ---------- */
	.about-body .lead {
		font-size: clamp(24px, 3.4vw, 40px);
		font-weight: 900;
		letter-spacing: 0.04em;
		margin-bottom: 22px;
	}

	.about-body p {
		max-width: 680px;
		font-size: 16px;
		letter-spacing: 0.05em;
		color: var(--gray);
	}

	/* ---------- Contact ---------- */
	.contact-body p {
		color: var(--gray);
	}

	.mail {
		display: inline-block;
		margin-top: 18px;
		font-size: clamp(22px, 3vw, 34px);
		font-weight: 700;
		letter-spacing: 0.04em;
		padding-bottom: 4px;
		border-bottom: 1px solid var(--line);
		transition: border-color 0.3s;
	}

	.mail:hover {
		border-color: var(--ink);
	}

	.links {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
		margin-top: 30px;
		font-size: 14px;
		letter-spacing: 0.18em;
	}

	.links a {
		display: inline-block;
		padding: 9px 22px;
		border: 1px solid var(--line);
		color: var(--gray);
		transition: all 0.3s;
	}

	.links a:hover {
		border-color: rgba(241, 239, 233, 0.5);
		color: var(--ink);
	}

	.links .placeholder {
		opacity: 0.45;
	}

	/* ---------- 尾層視覺 ---------- */
	.closing {
		position: relative;
		min-height: 90vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		overflow: hidden;
	}

	.closing-bg {
		position: absolute;
		inset: 0;
		background-position: center;
		background-size: cover;
	}

	.closing-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(6, 6, 8, 0.85) 0%, rgba(6, 6, 8, 0.25) 38%, rgba(6, 6, 8, 0.25) 62%, rgba(6, 6, 8, 0.9) 100%);
	}

	.closing-inner {
		position: relative;
		padding: 0 24px;
	}

	.closing-inner .kicker {
		font-family: 'Space Grotesk', monospace;
		font-size: 12px;
		letter-spacing: 0.45em;
		color: var(--gray);
		margin-bottom: 20px;
	}

	.closing-inner h2 {
		font-size: clamp(40px, 7vw, 84px);
		font-weight: 900;
		letter-spacing: 0.1em;
		margin-right: -0.1em;
	}

	.closing-inner .mail {
		font-size: clamp(18px, 2.4vw, 26px);
		color: var(--gray);
		border-color: rgba(241, 239, 233, 0.25);
	}

	.closing-inner .mail:hover {
		color: var(--ink);
		border-color: var(--ink);
	}

	.top {
		display: inline-block;
		margin-top: 48px;
		font-size: 13px;
		letter-spacing: 0.3em;
		color: var(--gray);
		transition: color 0.25s;
	}

	.top:hover {
		color: var(--ink);
	}

	/* ---------- Responsive ---------- */
	@media (max-width: 900px) {
		.hero-inner {
			grid-template-columns: 1fr;
			gap: 40px;
			padding-top: 80px;
		}

		.photo {
			max-width: 360px;
			width: 100%;
			margin: 0 auto;
		}

		.copy {
			text-align: center;
		}

		.copy .sub {
			margin-left: auto;
			margin-right: auto;
		}

		.grid {
			grid-template-columns: 1fr;
			gap: 44px;
		}
	}

	@media (max-width: 640px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
