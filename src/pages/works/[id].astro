---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { works } from '../../data/works';

export function getStaticPaths() {
	return works.map((work) => ({
		params: { id: work.id },
		props: { work },
	}));
}

const { work } = Astro.props;
const base = import.meta.env.BASE_URL;

const index = works.findIndex((w) => w.id === work.id);
const prev = works[index - 1];
const next = works[index + 1];
const idx = String(index + 1).padStart(2, '0');
---

<BaseLayout title={`${work.title} ｜ 胡正男`} description={work.description}>
	<div class="detail">
		<nav class="crumb">
			<a href={base + '#works'}>← 作品</a>
			<span class="sep">/</span>
			<span class="idx">{idx}</span>
		</nav>

		<div class="head">
			<p class="meta-line">
				<span class="cat">{work.category}</span>
				<span class="year">{work.year}</span>
			</p>
			<h1 class="chrome shine">{work.title}</h1>
		</div>

		<figure class="visual frame">
			<Image src={work.cover} alt={work.title} widths={[900, 1400]} sizes="100vw" />
		</figure>

		<div class="body">
			<h2 class="kicker">ABOUT THE PROJECT</h2>
			<p class="desc">{work.description}</p>
			<a class="behance" href="https://www.behance.net/fa7fd025" target="_blank" rel="noopener">
				在 Behance 查看完整專案 ↗
			</a>
		</div>

		<div class="gallery">
			{work.images.map((img, i) => (
				<figure class="shot frame">
					<Image src={img} alt={`${work.title} ${i + 1}`} widths={[900, 1400]} sizes="100vw" loading="lazy" />
				</figure>
			))}
		</div>

		<nav class="pager">
			{prev ? (
				<a href={base + 'works/' + prev.id + '/'}>
					<span class="arrow">←</span>
					<span class="p-title">{prev.title}</span>
				</a>
			) : (
				<span></span>
			)}
			{next ? (
				<a href={base + 'works/' + next.id + '/'}>
					<span class="p-title">{next.title}</span>
					<span class="arrow">→</span>
				</a>
			) : (
				<span></span>
			)}
		</nav>
	</div>
</BaseLayout>

<style>
	.detail {
		max-width: 1200px;
		margin: 0 auto;
		padding: 48px 24px 110px;
	}

	.crumb {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 40px;
		font-family: 'Space Grotesk', monospace;
		font-size: 13px;
		letter-spacing: 0.2em;
		color: var(--gray);
	}

	.crumb a:hover {
		color: var(--ink);
	}

	.crumb .sep {
		color: var(--dim);
	}

	.crumb .idx {
		color: var(--prism-cyan);
	}

	.head {
		margin-bottom: 44px;
	}

	.meta-line {
		display: flex;
		gap: 12px;
		margin-bottom: 18px;
		font-family: 'Space Grotesk', monospace;
		font-size: 12px;
		letter-spacing: 0.2em;
	}

	.meta-line .cat {
		color: var(--ink);
		border: 1px solid var(--line);
		padding: 5px 14px;
		background: var(--surface-2);
	}

	.meta-line .cat::before {
		content: '◆ ';
		color: var(--prism-cyan);
		font-size: 9px;
	}

	.meta-line .year {
		color: var(--gray);
		align-self: center;
	}

	.head h1 {
		font-size: clamp(34px, 5.4vw, 68px);
		font-weight: 900;
		letter-spacing: 0.05em;
		line-height: 1.15;
	}

	.frame {
		padding: 1px;
		background: linear-gradient(180deg, #2c2c36, #16161d);
	}

	.visual {
		margin-bottom: 44px;
	}

	.frame :global(img) {
		width: 100%;
		display: block;
	}

	.body {
		max-width: 680px;
	}

	.kicker {
		font-family: 'Space Grotesk', monospace;
		font-size: 12px;
		letter-spacing: 0.34em;
		color: var(--prism-purple);
		margin-bottom: 16px;
		font-weight: 500;
	}

	.desc {
		font-size: 16px;
		letter-spacing: 0.05em;
		line-height: 2;
		white-space: pre-line;
		color: var(--gray);
	}

	.desc::first-letter {
		color: var(--ink);
		font-weight: 700;
	}

	.behance {
		display: inline-block;
		margin-top: 28px;
		padding: 11px 26px;
		border: 1px solid var(--line);
		font-size: 14px;
		letter-spacing: 0.14em;
		color: var(--gray);
		transition: all 0.3s;
	}

	.behance:hover {
		border-color: transparent;
		background: linear-gradient(120deg, var(--prism-blue), var(--prism-purple), var(--prism-amber));
		color: #0a0a0c;
		font-weight: 700;
	}

	.gallery {
		margin-top: 64px;
		display: grid;
		gap: 26px;
	}

	.shot {
		box-shadow: 0 0 0 rgba(177, 140, 255, 0);
		transition: box-shadow 0.4s ease, background 0.4s ease;
	}

	.shot:hover {
		background: linear-gradient(
			120deg,
			rgba(109, 179, 255, 0.55),
			rgba(177, 140, 255, 0.45),
			rgba(255, 176, 102, 0.5)
		);
		box-shadow: 0 0 34px rgba(177, 140, 255, 0.16);
	}

	.pager {
		display: flex;
		justify-content: space-between;
		gap: 24px;
		margin-top: 88px;
		padding-top: 26px;
		border-top: 1px solid var(--line);
		font-size: 14px;
		letter-spacing: 0.05em;
	}

	.pager a {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--gray);
		transition: color 0.25s;
	}

	.pager a:hover {
		color: var(--ink);
	}

	.pager .arrow {
		font-family: 'Space Grotesk', monospace;
		color: var(--prism-amber);
	}

	.pager .p-title {
		max-width: 300px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	@media (max-width: 640px) {
		.pager .p-title {
			max-width: 42vw;
		}
	}
</style>
